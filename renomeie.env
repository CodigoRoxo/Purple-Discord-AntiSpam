# Arquivo .env — renomeie este arquivo para .env e preencha os valores
# Se inscreva no canal - Código Roxo para mais conteúdo como esse! Bora pra cima, purplecoders! <3

# Token do seu bot (obtenha em https://discord.com/developers/applications)
DISCORD_TOKEN=SEU_TOKEN_AQUI

# ID do canal onde o bot vai logar as ações de moderação (opcional)
# Para pegar o ID: ative Modo Desenvolvedor no Discord > clique direito no canal > Copiar ID
# formato: guild_id:channel_id,guild_id:channel_id
LOG_CHANNEL_IDS=XXXXXXXXXXXXXXXX:YYYYYYYYYYYYYY,ZZZZZZZZZZZZZZZ:AAAAAAAAAAAAAAA

# ID do server:canal onde o bot vai jogar a mensagem do HALL OF SHAME
SHAME_CHANNEL_IDS=XXXXXXXXXXXXXXXX:YYYYYYYYYYYYYY,ZZZZZZZZZZZZZZZ:AAAAAAAAAAAAAAA

# Cargos isentos de verificação (separados por vírgula)
# Exemplo: EXEMPT_ROLE_IDS=123456789012345999, 987654321098765999
EXEMPT_ROLE_IDS=XXXXXXXXXXXXXXXX

# ------------------------------
# NOVAS CONFIGURACOES ANTI-SPAM
# ------------------------------

# Flood base
FLOOD_LIMIT=5
FLOOD_WINDOW_SEC=8

# Punição progressiva (minutos por reincidência): 1x, 2x, 3x, 4x+
TIMEOUT_STEPS_MINUTES=10,60,1440,4320

# Score para disparar moderação
SCORE_THRESHOLD=60

# Similaridade para mensagens quase iguais (0.0 a 1.0)
MESSAGE_SIMILARITY_THRESHOLD=0.90

# Links externos
EXTERNAL_LINK_SCORE=55

# Convites do Discord (discord.gg / discord.com/invite): false = bloqueia, true = permite
ALLOW_DISCORD_INVITES=false

ALLOWED_DOMAINS=discord.com, discord.gg, discordapp.com, cdn.discordapp.com, media.discordapp.net, tenor.com, media.tenor.com, youtube.com, youtu.be, github.com, docs.python.org

# Raid detection
SUSPICIOUS_ACCOUNT_MAX_AGE_DAYS=14
RAID_WINDOW_SEC=10
RAID_USER_THRESHOLD=5
RAID_JOIN_GRACE_SEC=900
RAID_COOLDOWN_SEC=30
